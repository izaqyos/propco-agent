# Copy to .env for local runs. Never commit .env.
# All app settings are prefixed PROPCO_ (see src/propco_agent/config.py).

# LLM provider: gemini | ollama | fake
PROPCO_LLM_PROVIDER=gemini

# Gemini (Google AI Studio, free tier). The key is read by the Google SDK from the
# environment; it is never stored in app settings or logged.
# Create one at https://aistudio.google.com/apikey
# GOOGLE_API_KEY=
# Small model handles routing/extraction (higher free-tier quota); large model writes answers.
PROPCO_GEMINI_MODEL_SMALL=gemini-2.5-flash-lite
PROPCO_GEMINI_MODEL_LARGE=gemini-2.5-flash

# Ollama (fully offline alternative)
PROPCO_OLLAMA_BASE_URL=http://localhost:11434
PROPCO_OLLAMA_MODEL=qwen3.5:9b

# Data
PROPCO_DATA_PATH=data/amiio.parquet
PROPCO_DATA_POLICY=raw          # raw | dedup
# PROPCO_AS_OF=2025-M03         # default: max month in data
PROPCO_CURRENCY=EUR

# Runtime
PROPCO_LLM_TIMEOUT_S=60
PROPCO_LLM_MAX_RETRIES=2
PROPCO_RECURSION_LIMIT=25
PROPCO_MAX_INPUT_CHARS=2000
PROPCO_LOG_JSON=false

# Observability (opt-in)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=propco-agent
