# Copy to .env for local runs. Never commit .env.
# All settings are prefixed PROPCO_ (see src/propco_agent/config.py).

# LLM provider: ollama | anthropic | fake
PROPCO_LLM_PROVIDER=ollama
PROPCO_OLLAMA_BASE_URL=http://localhost:11434
PROPCO_OLLAMA_MODEL=qwen3.5:9b

# Cloud provider (used when PROPCO_LLM_PROVIDER=anthropic).
# The key is read by the Anthropic SDK directly; it is never stored in app settings.
# ANTHROPIC_API_KEY=
PROPCO_ANTHROPIC_MODEL_SMALL=claude-haiku-4-5
PROPCO_ANTHROPIC_MODEL_LARGE=claude-haiku-4-5

# Data
PROPCO_DATA_PATH=data/amiio.parquet
PROPCO_DATA_POLICY=raw          # raw | dedup
# PROPCO_AS_OF=2025-M03         # default: max month in data
PROPCO_CURRENCY=EUR

# Runtime
PROPCO_LLM_TIMEOUT_S=60
PROPCO_LLM_MAX_RETRIES=2
PROPCO_RECURSION_LIMIT=25
PROPCO_MAX_INPUT_CHARS=2000
PROPCO_LOG_JSON=false

# Observability (opt-in)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=propco-agent
